    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', 'Fira Code', monospace",
    "editor.fontLigatures": true,
    "editor.tokenColorCustomizations": {
        "comments": "#565f89",
        "strings": "#9ece6a",
        "keywords": "#bb9af7",
        "numbers": "#e0af68",
        "types": "#7dcfff",
        "functions": "#7dcfff",
        "variables": "#c9d1d9",
        "semanticHighlighting": true,
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#565f89",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier",
                    "keyword.control"
                ],
                "settings": {
                    "foreground": "#bb9af7"
                }
            },
            {
                "scope": [
                    "string",
                    "punctuation.definition.string",
                    "string.quoted"
                ],
                "settings": {
                    "foreground": "#9ece6a"
                }
            },
            {
                "scope": [
                    "constant.numeric",
                    "constant.language",
                    "constant.character.escape"
                ],
                "settings": {
                    "foreground": "#e0af68"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function",
                    "meta.function-call"
                ],
                "settings": {
                    "foreground": "#7dcfff"
                }
            },
            {
                "scope": [
                    "entity.name.type",
                    "entity.name.class",
                    "support.type",
                    "support.class"
                ],
                "settings": {
                    "foreground": "#e0af68"
                }
            },
            {
                "scope": [
                    "variable",
                    "variable.other",
                    "meta.object-literal.key"
                ],
                "settings": {
                    "foreground": "#c9d1d9"
                }
            },
            {
                "scope": [
                    "variable.parameter"
                ],
                "settings": {
                    "foreground": "#e0af68"
                }
            },
            {
                "scope": [
                    "entity.name.tag",
                    "support.class.component"
                ],
                "settings": {
                    "foreground": "#f7768e"
                }
            },
            {
                "scope": [
                    "entity.other.attribute-name"
                ],
                "settings": {
                    "foreground": "#e0af68",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "keyword.operator"
                ],
                "settings": {
                    "foreground": "#7dcfff"
                }
            },
            {
                "scope": [
                    "punctuation",
                    "meta.brace"
                ],
                "settings": {
                    "foreground": "#a9b1d6"
                }
            },
            {
                "scope": [
                    "markup.heading"
                ],
                "settings": {
                    "foreground": "#8ab4f8",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "markup.bold"
                ],
                "settings": {
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "markup.italic"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "markup.inline.raw",
                    "markup.fenced_code.block"
                ],
                "settings": {
                    "foreground": "#9ece6a"
                }
            },
            {
                "scope": [
                    "invalid",
                    "invalid.illegal"
                ],
                "settings": {
                    "foreground": "#f7768e"
                }
            }
        ]
    },
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorBlinking": true,
    "window.autoDetectColorScheme": false,
    "editor.semanticHighlighting.enabled": true,
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "namespace": "#8ab4f8",
            "class": "#e0af68",
            "enum": "#e0af68",
            "interface": "#e0af68",
            "struct": "#e0af68",
            "typeParameter": "#e0af68",
            "type": "#7dcfff",
            "parameter": "#e0af68",
            "variable": "#c9d1d9",
            "property": "#7dcfff",
            "enumMember": "#e0af68",
            "function": "#7dcfff",
            "method": "#7dcfff",
            "macro": "#bb9af7",
            "keyword": "#bb9af7",
            "modifier": "#bb9af7",
            "comment": {
                "foreground": "#565f89",
                "italic": true
            },
            "string": "#9ece6a",
            "number": "#e0af68",
            "regexp": "#9ece6a",
            "operator": "#7dcfff"
        }
    }
}
